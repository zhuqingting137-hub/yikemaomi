.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: radial-gradient(circle at 50% 30%, #2b2136 0%, #1a1420 70%);
}
.game {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.topbar {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 10px);
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 16px;
  pointer-events: none;
  z-index: 5;
}
.timer {
  background: rgba(0, 0, 0, 0.4);
  padding: 6px 14px;
  border-radius: 16px;
  font-size: 14px;
  font-variant-numeric: tabular-nums;
}
.catname {
  background: rgba(0, 0, 0, 0.4);
  padding: 6px 12px;
  border-radius: 16px;
  font-size: 13px;
  color: #ffd28a;
}
.hint {
  position: absolute;
  bottom: 16%;
  left: 50%;
  transform: translateX(-50%);
  max-width: 80%;
  text-align: center;
  padding: 10px 18px;
  border-radius: 22px;
  background: rgba(0, 0, 0, 0.5);
  font-size: 14px;
  line-height: 1.6;
  z-index: 5;
}
.end {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}
.end-panel {
  text-align: center;
  padding: 0 30px;
  width: 100%;
}
.end-emoji {
  font-size: 90px;
  margin-bottom: 14px;
}
.end-title {
  font-size: 26px;
  margin-bottom: 8px;
}
.end-desc {
  color: #c9b8d8;
  margin-bottom: 26px;
  font-size: 15px;
}
.btn {
  display: block;
  width: 230px;
  margin: 0 auto 12px;
  padding: 13px 0;
  border: 0;
  border-radius: 26px;
  font-size: 16px;
  background: linear-gradient(135deg, #ff9a56, #ff5e7e);
  color: #fff;
  line-height: 1.4;
}
.btn.ghost {
  background: transparent;
  border: 1px solid #8b7aa0;
  color: #c9b8d8;
}
