.end-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #1a1420;
}
.emoji { font-size: 90px; margin-bottom: 16px; }
.title { font-size: 26px; margin-bottom: 10px; }
.desc { color: #c9b8d8; font-size: 15px; margin-bottom: 30px; }
.btn {
  width: 230px;
  padding: 13px 0;
  border: 0;
  border-radius: 26px;
  font-size: 16px;
  background: linear-gradient(135deg, #ff9a56, #ff5e7e);
  color: #fff;
}
